{
  "schema": "marksheet.formula-conformance@1",
  "profile": "portable-a1@1",
  "cases": [
    { "id": "eval.operator.precedence", "formula": "=1+2*3", "expect": { "value": { "kind": "number", "value": 7 } } },
    { "id": "eval.operator.power-right-associative", "formula": "=2^3^2", "expect": { "value": { "kind": "number", "value": 512 } } },
    { "id": "eval.operator.power-before-unary", "formula": "=-2^2", "expect": { "value": { "kind": "number", "value": -4 } } },
    { "id": "eval.operator.power-parenthesized-negative", "formula": "=(-2)^2", "expect": { "value": { "kind": "number", "value": 4 } } },
    { "id": "eval.operator.power-negative-exponent", "formula": "=2^-2", "expect": { "value": { "kind": "number", "value": 0.25 } } },
    { "id": "eval.operator.left-associative-subtraction", "formula": "=10-3-2", "expect": { "value": { "kind": "number", "value": 5 } } },
    { "id": "eval.operator.blank-to-zero", "cells": { "A1": { "kind": "blank" } }, "formula": "=A1+2", "expect": { "value": { "kind": "number", "value": 2 } } },
    { "id": "eval.operator.boolean-to-number", "formula": "=TRUE+FALSE+2", "expect": { "value": { "kind": "number", "value": 3 } } },
    { "id": "eval.operator.text-not-number", "formula": "=\"2\"+1", "expect": { "value": { "kind": "error", "value": "#VALUE!" } } },
    { "id": "eval.operator.divide-zero", "formula": "=1/0", "expect": { "value": { "kind": "error", "value": "#DIV/0!" } } },
    { "id": "eval.operator.zero-power-zero", "formula": "=0^0", "expect": { "value": { "kind": "number", "value": 1 } } },
    { "id": "eval.operator.zero-negative-power", "formula": "=0^-1", "expect": { "value": { "kind": "error", "value": "#DIV/0!" } } },
    { "id": "eval.operator.negative-fractional-power", "formula": "=(-1)^0.5", "expect": { "value": { "kind": "error", "value": "#NUM!" } } },
    { "id": "eval.operator.concat-coercion", "cells": { "A1": { "kind": "blank" } }, "formula": "=A1&12&TRUE&DATE(2026,8,16)", "expect": { "value": { "kind": "text", "value": "12TRUE2026-08-16" } } },
    { "id": "eval.operator.concat-preserves-offset", "cells": { "A1": { "kind": "datetime", "value": "2026-08-16T10:30:00-04:00" } }, "formula": "=\"at \"&A1", "expect": { "value": { "kind": "text", "value": "at 2026-08-16T10:30:00-04:00" } } },
    { "id": "eval.operator.blank-not-empty-text", "cells": { "A1": { "kind": "blank" }, "A2": { "kind": "text", "value": "" } }, "formula": "=A1=A2", "expect": { "value": { "kind": "boolean", "value": false } } },
    { "id": "eval.operator.mixed-types-not-equal", "formula": "=1=TRUE", "expect": { "value": { "kind": "boolean", "value": false } } },
    { "id": "eval.operator.text-case-sensitive", "formula": "=\"A\"=\"a\"", "expect": { "value": { "kind": "boolean", "value": false } } },
    { "id": "eval.operator.text-order-unicode-scalar", "formula": "=\"A\"<\"a\"", "expect": { "value": { "kind": "boolean", "value": true } } },
    { "id": "eval.operator.mixed-order-value-error", "formula": "=1<TRUE", "expect": { "value": { "kind": "error", "value": "#VALUE!" } } },
    { "id": "eval.operator.datetime-order-by-instant", "cells": { "A1": { "kind": "datetime", "value": "2026-08-16T10:30:00-04:00" }, "A2": { "kind": "datetime", "value": "2026-08-16T15:00:00Z" } }, "formula": "=A1<A2", "expect": { "value": { "kind": "boolean", "value": true } } },
    { "id": "eval.operator.datetime-equality-includes-offset", "cells": { "A1": { "kind": "datetime", "value": "2026-08-16T10:30:00-04:00" }, "A2": { "kind": "datetime", "value": "2026-08-16T14:30:00Z" } }, "formula": "=A1=A2", "expect": { "value": { "kind": "boolean", "value": false } } },
    { "id": "eval.operator.first-error-left", "formula": "=#N/A+#REF!", "expect": { "value": { "kind": "error", "value": "#N/A" } } },
    { "id": "eval.operator.first-error-right", "formula": "=1+#REF!", "expect": { "value": { "kind": "error", "value": "#REF!" } } },
    { "id": "eval.operator.range-requires-consumer", "cells": { "A1": { "kind": "number", "value": 1 }, "A2": { "kind": "number", "value": 2 } }, "formula": "=A1:A2", "expect": { "value": { "kind": "error", "value": "#VALUE!" } } },
    { "id": "eval.operator.one-cell-range-remains-range", "cells": { "A1": { "kind": "number", "value": 7 } }, "formula": "=A1:A1", "expect": { "value": { "kind": "error", "value": "#VALUE!" } } },
    { "id": "eval.operator.unknown-function", "formula": "=MISSING(1)", "expect": { "value": { "kind": "error", "value": "#NAME?" } } },
    { "id": "eval.operator.unknown-name", "formula": "=missing_name", "expect": { "value": { "kind": "error", "value": "#NAME?" } } }
  ]
}
