{
  "schema": "marksheet.formula-conformance@1",
  "profile": "portable-a1@1",
  "cases": [
    { "id": "eval.function.abs", "formula": "=ABS(-3)", "expect": { "value": { "kind": "number", "value": 3 } } },
    { "id": "eval.function.int.negative-floor", "formula": "=INT(-1.2)", "expect": { "value": { "kind": "number", "value": -2 } } },
    { "id": "eval.function.mod.positive-divisor", "formula": "=MOD(-5,3)", "expect": { "value": { "kind": "number", "value": 1 } } },
    { "id": "eval.function.mod.negative-divisor", "formula": "=MOD(5,-3)", "expect": { "value": { "kind": "number", "value": -1 } } },
    { "id": "eval.function.mod.zero", "formula": "=MOD(1,0)", "expect": { "value": { "kind": "error", "value": "#DIV/0!" } } },
    { "id": "eval.function.round.tie-positive", "formula": "=ROUND(2.5,0)", "expect": { "value": { "kind": "number", "value": 3 } } },
    { "id": "eval.function.round.tie-negative", "formula": "=ROUND(-2.5,0)", "expect": { "value": { "kind": "number", "value": -3 } } },
    { "id": "eval.function.round.negative-digits", "formula": "=ROUND(125,-1)", "expect": { "value": { "kind": "number", "value": 130 } } },
    { "id": "eval.function.roundup.away", "formula": "=ROUNDUP(-1.21,1)", "expect": { "value": { "kind": "number", "value": -1.3 } } },
    { "id": "eval.function.rounddown.toward-zero", "formula": "=ROUNDDOWN(-1.29,1)", "expect": { "value": { "kind": "number", "value": -1.2 } } },
    { "id": "eval.function.round.exact-value-below-half", "formula": "=ROUND(0.15,1)", "expect": { "value": { "kind": "number", "value": 0.1 } } },
    { "id": "eval.function.round.exact-value-not-a-tie", "formula": "=ROUND(2.675,2)", "expect": { "value": { "kind": "number", "value": 2.67 } } },
    { "id": "eval.function.roundup.exact-value-remainder", "formula": "=ROUNDUP(0.15,1)", "expect": { "value": { "kind": "number", "value": 0.2 } } },
    { "id": "eval.function.roundup.exact-value-no-remainder", "formula": "=ROUNDUP(0.25,2)", "expect": { "value": { "kind": "number", "value": 0.25 } } },
    { "id": "eval.function.rounddown.exact-value", "formula": "=ROUNDDOWN(2.675,2)", "expect": { "value": { "kind": "number", "value": 2.67 } } },
    { "id": "eval.function.round.nonintegral-digits", "formula": "=ROUND(1,1.5)", "expect": { "value": { "kind": "error", "value": "#NUM!" } } },
    { "id": "eval.function.concat.range", "cells": { "A1": { "kind": "text", "value": "a" }, "A2": { "kind": "number", "value": 2 }, "A3": { "kind": "boolean", "value": true } }, "formula": "=CONCAT(A1:A3)", "expect": { "value": { "kind": "text", "value": "a2TRUE" } } },
    { "id": "eval.function.left.default", "formula": "=LEFT(\"abc\")", "expect": { "value": { "kind": "text", "value": "a" } } },
    { "id": "eval.function.left.count", "formula": "=LEFT(\"abc\",2)", "expect": { "value": { "kind": "text", "value": "ab" } } },
    { "id": "eval.function.right.default", "formula": "=RIGHT(\"abc\")", "expect": { "value": { "kind": "text", "value": "c" } } },
    { "id": "eval.function.mid", "formula": "=MID(\"abcd\",2,2)", "expect": { "value": { "kind": "text", "value": "bc" } } },
    { "id": "eval.function.mid.beyond-end", "formula": "=MID(\"abc\",9,2)", "expect": { "value": { "kind": "text", "value": "" } } },
    { "id": "eval.function.mid.invalid-start", "formula": "=MID(\"abc\",0,1)", "expect": { "value": { "kind": "error", "value": "#NUM!" } } },
    { "id": "eval.function.len.unicode-scalars", "formula": "=LEN(\"A😀\")", "expect": { "value": { "kind": "number", "value": 2 } } },
    { "id": "eval.function.lower.ascii-only", "formula": "=LOWER(\"ÄBC\")", "expect": { "value": { "kind": "text", "value": "Äbc" } } },
    { "id": "eval.function.upper.ascii-only", "formula": "=UPPER(\"äbc\")", "expect": { "value": { "kind": "text", "value": "äBC" } } },
    { "id": "eval.function.trim.ascii-space", "formula": "=TRIM(\"  a   b  \")", "expect": { "value": { "kind": "text", "value": "a b" } } },
    { "id": "eval.function.trim.preserves-tab", "formula": "=TRIM(\" a\tb \")", "expect": { "value": { "kind": "text", "value": "a\tb" } } },
    { "id": "eval.function.text.coerces-number", "formula": "=LEN(120)", "expect": { "value": { "kind": "number", "value": 3 } } }
  ]
}
